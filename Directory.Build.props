<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <LangVersion>latest</LangVersion>
    <!-- Ensure all projects produce NuGet-compatible outputs -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Encoding -->
    <FileAlignment>512</FileAlignment>
  </PropertyGroup>

  <!-- Suppress specific warnings that are intentional across the codebase -->
  <!-- CS1591 = missing XML doc comment; suppressed globally since we do not require XML docs on internals -->
  <PropertyGroup>
    <NoWarn>CS1591</NoWarn>
  </PropertyGroup>
</Project>
