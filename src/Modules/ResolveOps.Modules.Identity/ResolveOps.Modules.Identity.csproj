<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!--
      Identity module references EF Core directly (not ResolveOps.Persistence) to avoid
      a circular dependency: Persistence → Identity → Persistence.
      EF configurations only need Microsoft.EntityFrameworkCore, not the full Persistence project.
      AppDbContext (in Persistence) discovers these configurations via assembly scanning.
      See docs/assumptions.md — A-012.
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\BuildingBlocks\ResolveOps.Domain\ResolveOps.Domain.csproj" />
    <ProjectReference Include="..\..\BuildingBlocks\ResolveOps.Security\ResolveOps.Security.csproj" />
    <ProjectReference Include="..\..\BuildingBlocks\ResolveOps.Persistence\ResolveOps.Persistence.csproj" />
  </ItemGroup>

</Project>
