{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "ResolveOps",
    "Audience": "ResolveOps",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationMinutes": 10080
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "resolveops": "",
    "redis": ""
  },
  "OpenTelemetry": {
    "ServiceName": "ResolveOps.Api"
  },
  "Outbox": {
    "PollIntervalSeconds": 5,
    "BatchSize": 50,
    "MaxAttempts": 5
  },
  "RabbitMqConsumer": {
    "PrefetchCount": 10,
    "RetryLimit": 3
  },
  "Smtp": {
    "Host": "localhost",
    "Port": 1025,
    "EnableSsl": false,
    "SenderEmail": "notifications@resolveops.local",
    "SenderName": "ResolveOps System"
  }
}
