<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsAspireHost>true</IsAspireHost>
    <AspireHostingSDKVersion>9.0.0</AspireHostingSDKVersion>
    <!--
      Suppress vulnerability audit warnings for Aspire AppHost only.
      Aspire 9.x transitively pulls MessagePack and KubernetesClient which
      have known CVEs without available fixes.
    -->
    <NoWarn>$(NoWarn);NU1902;NU1903</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" />
    <PackageReference Include="Aspire.Hosting.SqlServer" />
    <PackageReference Include="Aspire.Hosting.Redis" />
  </ItemGroup>

  <ItemGroup>
    <!-- Aspire discovers referenced projects as orchestration resources -->
    <ProjectReference Include="..\..\Hosts\ResolveOps.Api\ResolveOps.Api.csproj" />
    <ProjectReference Include="..\..\Hosts\ResolveOps.Worker\ResolveOps.Worker.csproj" />
  </ItemGroup>

</Project>
