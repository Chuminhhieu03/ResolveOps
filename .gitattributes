# Git attributes for ResolveOps
# Ensures consistent line endings across Windows, macOS, Linux contributors.

# Default: normalize line endings to LF on commit
* text=auto eol=lf

# Source code — always LF
*.cs        text eol=lf
*.csx       text eol=lf
*.fs        text eol=lf
*.fsx       text eol=lf
*.ts        text eol=lf
*.html      text eol=lf
*.css       text eol=lf
*.scss      text eol=lf
*.json      text eol=lf
*.jsonc     text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.xml       text eol=lf
*.csproj    text eol=lf
*.props     text eol=lf
*.targets   text eol=lf
*.slnx      text eol=lf
*.sln       text eol=lf
*.md        text eol=lf
*.sh        text eol=lf
*.ps1       text eol=lf
*.sql       text eol=lf
*.gitignore text eol=lf

# Windows-specific scripts — keep CRLF on Windows checkout
*.bat       text eol=crlf
*.cmd       text eol=crlf

# Binary files — do not touch line endings
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.zip  binary
*.gz   binary
*.tar  binary
*.nupkg binary
*.snupkg binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary
